  "vdec": true,
  "thermal": { "zones": 3, "maxC": 90 },
  "rtc": { "battery": true },
  "linux": {
    "ethernet": true, "usbControllers": 2, "usbHub": false,
    "emmc": false, "sd": "optional", "nvme": "optional",
    "hdmi": true, "gpu": true, "thermalZones": 6, "fan": "optional", "rtc": "hym8563",
    "npu": "optional", "vdec": "optional",
    "dmesgIgnore": []
  }
}
