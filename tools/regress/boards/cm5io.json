  "network": { "ethernet": true, "wifi": false, "bluetooth": false },
  "usb": { "controllers": 2, "hub": true },
  "storage": { "emmc": true, "sd": "optional", "nvme": true },
  "npuCores": 2,
  "npu": "optional",
  "vdec": true,
  "thermal": { "zones": 3, "maxC": 90 },
  "rtc": { "battery": true },
  "linux": {
    "ethernet": true, "usbControllers": 2, "usbHub": true,
    "emmc": true, "sd": "optional", "nvme": true,
    "hdmi": true, "gpu": true, "thermalZones": 6, "fan": "optional", "rtc": "hym8563",
    "npu": "optional", "vdec": "optional",
    "dmesgIgnore": []
  }
