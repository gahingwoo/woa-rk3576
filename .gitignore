# WDK / MSBuild build output
[Aa][Rr][Mm]64/
[Xx]64/
[Dd]ebug/
[Rr]elease/
Build/
*.obj
*.pdb
*.sys
*.cat
*.lib
*.exp
*.ilk
*.log
*.tmp
*.tmh

# VS / WDK per-user
*.user
*.suo
.vs/

# Test-signing material — never commit private keys/certs
*.cer
*.pfx
*.pvk

# ...but arm64/ is also a *source* directory for the hand-written SMC stub, and
# the output rule above would otherwise silently swallow it.
!drivers/storage/rkdwmmc/arm64/
!drivers/storage/rkdwmmc/arm64/*.asm
