<?xml version="1.0" encoding="utf-8"?>
<!--
  WDK / EWDK KMDF driver project for rk3576gpio (Windows on ARM64).

  Build with the EWDK developer prompt:
      LaunchBuildEnv.cmd                       (from the EWDK root)
      msbuild rk3576gpio.vcxproj /p:Configuration=Release /p:Platform=ARM64

  If MSBuild cannot find the WDK targets, the cleanest path is to create a new
  "Kernel Mode Driver, Empty (KMDF)" project in Visual Studio + WDK, set the
  platform to ARM64, then add driver.c / controller.c and the headers. The
  settings below mirror that template.
-->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{B3A5C1D2-4E6F-4A8B-9C0D-1E2F3A4B5C6D}</ProjectGuid>
    <TemplateGuid>{dd38f7fc-d7bd-488b-9242-7d8754cde80d}</TemplateGuid>
    <RootNamespace>rk3576gpio</RootNamespace>
    <MinimumVisualStudioVersion>14.0</MinimumVisualStudioVersion>
    <Configuration>Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">ARM64</Platform>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
    <!--
      Catalog target list. The WDK default for ARM64 is Server10_ARM64, i.e.
      build 14393, which predates the 16299 these INFs require for DIRID 13 --
      inf2cat then finds no installable DDInstall section and fails signability.
      RS3 is 16299, the real floor. 10_GE (Windows 11 24H2) is deliberately
      absent: RK3576 is ARMv8.0 and 24H2 requires ARMv8.1 LSE atomics, so it
      cannot boot on this silicon (see docs/BRINGUP-PLAN.md).
    -->
    <Inf2CatWindowsVersionList>10_RS3_ARM64,10_RS4_ARM64,10_RS5_ARM64,10_19H1_ARM64,10_VB_ARM64,10_CO_ARM64,10_NI_ARM64</Inf2CatWindowsVersionList>
    <!-- Must be declared here: the WDK targets read it at Cpp.props time. -->
    <KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
    <KMDF_VERSION_MINOR>33</KMDF_VERSION_MINOR>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />


  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <!-- _KERNEL_MODE is predefined by the WDK toolset; redefining it is C4117. -->
      <PreprocessorDefinitions>%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <!--
        msgpioclxstub.lib is the GpioClx import stub (there is no gpioclx.lib);
        ksguid.lib supplies the class-extension GUIDs.
      -->
      <AdditionalDependencies>$(DDK_LIB_PATH)\msgpioclxstub.lib;$(DDK_LIB_PATH)\ksguid.lib;$(DDK_LIB_PATH)\ntstrsafe.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Inf>
      <SpecifyArchitecture>true</SpecifyArchitecture>
      <Architecture>arm64</Architecture>
    </Inf>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="driver.c" />
    <ClCompile Include="controller.c" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="rk3576gpio.h" />
    <ClInclude Include="rk3576gpio_regs.h" />
    <ClInclude Include="..\..\inc\rk3576_soc.h" />
  </ItemGroup>

  <ItemGroup>
    <Inf Include="rk3576gpio.inf" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
