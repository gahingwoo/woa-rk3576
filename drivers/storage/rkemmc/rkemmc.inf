;
; rkemmc.inf - Rockchip RK3576 eMMC (DWCMSHC) sdport miniport
;
; Binds to the eMMC controller published as ACPI\RKCP0D40 in the EDK2 RK3576
; DSDT (Silicon/Rockchip/RK3576/AcpiTables/Emmc.asl). Target: Windows on ARM64.
;
; That node also carries _CID PNP0D40 so the Windows inbox SDHCI driver can
; bind to it. It does bind, and it starts, and no card ever enumerates -- an
; SDHCI SW_RST_ALL clears three Rockchip vendor bits that no inbox driver
; restores. A hardware ID match beats a compatible ID match, so installing
; this driver takes the device away from the inbox one, which is the intent.
;
; Copyright (c) 2026 Ga Hing Woo <gahing@gahingwoo.com>
; SPDX-License-Identifier: MIT
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = SDHost
ClassGuid   = {a0a588a4-c46f-4b37-b7ea-c82fe89870c6}
Provider    = %ProviderName%
DriverVer   = ; set by stampinf during build
CatalogFile = rkemmc.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
rkemmc.sys = 1

[Manufacturer]
%ProviderName% = Standard,NTARM64.10.0...16299

[Standard.NTARM64.10.0...16299]
%RKEMMC.DeviceDesc% = RKEMMC_Inst,ACPI\RKCP0D40

[RKEMMC_Inst.NT]
CopyFiles = RKEMMC_CopyFiles

[RKEMMC_CopyFiles]
rkemmc.sys

[RKEMMC_Inst.NT.Services]
AddService = rkemmc,0x00000002,RKEMMC_Service

[RKEMMC_Service]
DisplayName    = %RKEMMC.SvcDesc%
ServiceType    = 1 ; SERVICE_KERNEL_DRIVER
; Demand start while this driver is being brought up.
;
; It wants to be boot start eventually -- the eMMC is where Windows is meant
; to be installed, so the storage stack has to reach it before the boot
; volume is mounted.  But boot start also means any fault here is a boot
; fault, and the first image carrying this driver went 1 good boot to 3 bad
; where the same WinPE without it had gone 5 for 5.  Small numbers and not a
; clean comparison, but there is no reason to carry the risk during bring-up:
; PnP starts the driver when it enumerates the device either way, and WinPE
; does not boot from the eMMC.
;
; Move it back to 0 once it has been seen to work.
StartType      = 3 ; SERVICE_DEMAND_START
ErrorControl   = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\rkemmc.sys
LoadOrderGroup = System Bus Extender
; sdport.sys is bound via sdport.lib + SdPortInitialize.

[Strings]
ProviderName       = "woa-rk3576"
DiskName           = "RK3576 eMMC (DWCMSHC) Installation Disk"
RKEMMC.DeviceDesc  = "Rockchip RK3576 eMMC Host Controller (DWCMSHC)"
RKEMMC.SvcDesc     = "Rockchip RK3576 DWCMSHC eMMC Host Controller Driver"
