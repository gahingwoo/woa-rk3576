;
; aic8800wdi.inf - AICSemi AIC8800D80 USB Wi-Fi (Radxa ROCK 4D) as a WDI
; miniport for Windows' own Wi-Fi on Windows 10 2004..22H2 (build
; 19041..19045), which has no WiFiCx: the network list in Settings and on
; the taskbar, Windows' WPA2 supplicant, its profiles.
; USB\VID_A69C&PID_8D81&MI_02, the WLAN interface of the running firmware.
;
; Windows 11 takes aic8800wifi.inf (WiFiCx) instead: the models section for
; build 22000 and later is empty, so this INF matches nothing there.
; Install it with aic8800wdildr.inf (the ROM loader face, PID_8D80). Both
; run aic8800wdi.sys; settings are read from
; HKLM\SYSTEM\CurrentControlSet\Services\aic8800usb\Parameters as on
; Windows 11 (aic-bringup.ps1 -Stage, -Status). Needs Stage 2 or more (the
; firmware init); Ssid and Passphrase are not used. The firmware files are
; not part of this package; see docs/dev/aic8800.md (Windows 10) and
; install-firmware.ps1.
;
; Copyright (c) 2026 Ga Hing Woo <gahing@gahingwoo.com>
; SPDX-License-Identifier: GPL-2.0-only
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = Net
ClassGuid   = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = ; set by stampinf during build
CatalogFile = aic8800wdi.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
aic8800wdi.sys = 1

[Manufacturer]
%ProviderName% = Standard,NTARM64.10.0...19041,NTARM64.10.0...22000

[Standard.NTARM64.10.0...19041]
%AIC.RuntimeDesc% = AIC_Inst,USB\VID_A69C&PID_8D81&MI_02

; Windows 11: aic8800wifi.inf
[Standard.NTARM64.10.0...22000]

[AIC_Inst.NT]
CopyFiles           = AIC_CopyFiles
AddReg              = AIC_AddReg_Ndi
Include             = netvwifibus.inf
Needs               = VWiFiBus.CopyFiles
Characteristics     = 0x84  ; NCF_PHYSICAL | NCF_HAS_UI
BusType             = 15    ; PNPBus
*IfType             = 71    ; IF_TYPE_IEEE80211
*MediaType          = 16    ; NdisMediumNative802_11
*PhysicalMediaType  = 9     ; NdisPhysicalMediumNative802_11
*IfConnectorPresent = 1
*ConnectionType     = 1     ; NET_IF_CONNECTION_DEDICATED
*DirectionType      = 0     ; NET_IF_DIRECTION_SENDRECEIVE
*AccessType         = 2     ; NET_IF_ACCESS_BROADCAST
*HardwareLoopback   = 0

[AIC_AddReg_Ndi]
HKR, Ndi,            Service,    0, aic8800usb
HKR, Ndi\Interfaces, UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces, LowerRange, 0, "wlan,ethernet,vwifi"

[AIC_CopyFiles]
aic8800wdi.sys

[AIC_Inst.NT.HW]
AddReg  = AIC_AddReg_Hw
Include = netvwifibus.inf
Needs   = VWiFiBus.PnPFilterRegistration.HW

; Device Parameters. Mode 1: Windows' own Wi-Fi (the only mode here).
[AIC_AddReg_Hw]
HKR,,"Mode",0x00010001,1

[AIC_Inst.NT.Services]
AddService = aic8800usb,0x00000002,AIC_Service
Include    = netvwifibus.inf
Needs      = VWiFiBus.Services

[AIC_Service]
DisplayName    = %AIC.SvcDesc%
ServiceType    = 1 ; SERVICE_KERNEL_DRIVER
StartType      = 3 ; SERVICE_DEMAND_START
ErrorControl   = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\aic8800wdi.sys
LoadOrderGroup = NDIS
AddReg         = AIC_Service.AddReg

[AIC_Service.AddReg]
; Settings for both services (aic8800ldr reads them here too), as
; aic8800wifi.inf. FLG_ADDREG_NOCLOBBER (0x2) keeps a value set on the
; board across driver updates. Stage: 0 nothing is sent to the chip, 1 the
; loader downloads the firmware, 2 and up the Wi-Fi adapter.
HKR,Parameters,"Stage",0x00010003,0
HKR,Parameters,"FirmwareDir",0x00000002,"\SystemRoot\System32\drivers\aic8800"
HKR,Parameters,"ScanTimeoutMs",0x00010003,8000
HKR,Parameters,"ConnectTimeoutMs",0x00010003,15000

[AIC_Inst.NT.Wdf]
KmdfService = aic8800usb, AIC_wdfsect

[AIC_wdfsect]
KmdfLibraryVersion = 1.31

[Strings]
ProviderName     = "woa-rk3576"
DiskName         = "AIC8800D80 Wi-Fi (WDI) Installation Disk"
AIC.RuntimeDesc  = "AIC8800D80 USB Wi-Fi (WDI)"
AIC.SvcDesc      = "AIC8800D80 USB Wi-Fi driver (Windows 10, WDI)"
