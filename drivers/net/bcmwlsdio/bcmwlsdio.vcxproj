<?xml version="1.0" encoding="utf-8"?>
<!--
  WDK / EWDK KMDF driver project for bcmwlsdio (Windows on ARM64).

  Build (EWDK prompt, after LaunchBuildEnv.cmd):
      msbuild bcmwlsdio.vcxproj /p:Configuration=Release /p:Platform=ARM64
  See ..\..\..\docs\BUILDING.md (ARM64 host builds this natively).
-->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{3F8B2C61-7A4E-4D19-9B5E-43456A9BF0D2}</ProjectGuid>
    <TemplateGuid>{dd38f7fc-d7bd-488b-9242-7d8754cde80d}</TemplateGuid>
    <RootNamespace>bcmwlsdio</RootNamespace>
    <MinimumVisualStudioVersion>14.0</MinimumVisualStudioVersion>
    <Configuration>Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">ARM64</Platform>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
    <!--
      Catalog target list. The WDK default for ARM64 is Server10_ARM64, i.e.
      build 14393, which predates the 16299 these INFs require for DIRID 13, so
      inf2cat finds no installable DDInstall section and fails signability.
      RS3 is 16299, the real floor. 10_GE (Windows 11 24H2) is deliberately
      absent: RK3576 is ARMv8.0 and 24H2 requires ARMv8.1 LSE atomics, so it
      cannot boot on this silicon (see docs/BUILDING.md).
    -->
    <Inf2CatWindowsVersionList>10_RS3_ARM64,10_RS4_ARM64,10_RS5_ARM64,10_19H1_ARM64,10_VB_ARM64,10_CO_ARM64,10_NI_ARM64</Inf2CatWindowsVersionList>
    <!-- Must be declared here: the WDK targets read it at Cpp.props time. -->
    <KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
    <KMDF_VERSION_MINOR>33</KMDF_VERSION_MINOR>
    <!--
      NetAdapterCx 2.1 and WiFiCx 1.0. The KMDF stub binds both before
      DriverEntry, under either INF (the bring-up, Class System, never
      calls them), and a version the system does not register fails the
      load. The TaishanPi 3M's 23H2 (22631, netadaptercx.sys and wificx.sys
      10.0.22621.2215) registers NetAdapterCx 2.1 and WiFiCx 1.1 only
      (Control\Wdf\Kmdf\<cx>\Versions); 2.2 did not load there.
      Keep these at or below what that board lists.
    -->
    <NetAdapterDriver>true</NetAdapterDriver>
    <NETADAPTER_VERSION_MAJOR>2</NETADAPTER_VERSION_MAJOR>
    <NETADAPTER_VERSION_MINOR>1</NETADAPTER_VERSION_MINOR>
    <WifiDriver>true</WifiDriver>
    <WIFI_VERSION_MAJOR>1</WIFI_VERSION_MAJOR>
    <WIFI_VERSION_MINOR>0</WIFI_VERSION_MINOR>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />


  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <!-- _KERNEL_MODE is predefined by the WDK toolset; redefining it is C4117. -->
      <PreprocessorDefinitions>%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- ntddsd.h and sddef.h are in Include\<ver>\km; the WDI TLV
           generator/parser (wificx.cpp) in km\wlan\2.0. -->
      <AdditionalIncludeDirectories>$(DDK_INC_PATH)wlan\2.0;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- the class extension versions the WDK targets bind (above), for PreEntry -->
      <PreprocessorDefinitions>BWL_NETCX_MAJOR=$(NETADAPTER_VERSION_MAJOR);BWL_NETCX_MINOR=$(NETADAPTER_VERSION_MINOR);BWL_WIFICX_MAJOR=$(WIFI_VERSION_MAJOR);BWL_WIFICX_MINOR=$(WIFI_VERSION_MINOR);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <!-- sdbus.lib: SdBusOpenInterface and SdBusSubmitRequest.
           WificxTLVGenParse.lib: Microsoft's WDI TLV generator/parser (C++);
           libcntpr.lib: the __security_push/pop_cookie it references. -->
      <!-- BwlPreEntry writes a breadcrumb without WDF, then calls the KMDF
           stub's FxDriverEntry (which binds KMDF and the class extensions). -->
      <EntryPointSymbol>BwlPreEntry</EntryPointSymbol>
      <AdditionalDependencies>$(DDK_LIB_PATH)sdbus.lib;$(DDK_LIB_PATH)ntstrsafe.lib;$(DDK_LIB_PATH)wlan\2.0\WificxTLVGenParse.lib;$(DDK_LIB_PATH)libcntpr.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Inf>
      <SpecifyArchitecture>true</SpecifyArchitecture>
      <Architecture>arm64</Architecture>
    </Inf>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="driver.c" />
    <ClCompile Include="sdbus.c" />
    <ClCompile Include="files.c" />
    <ClCompile Include="pool.c" />
    <ClCompile Include="bwl_sdio.c" />
    <ClCompile Include="bwl_chip.c" />
    <ClCompile Include="bwl_bringup.c" />
    <ClCompile Include="bwl_fw.c" />
    <ClCompile Include="bwl_proto.c" />
    <ClCompile Include="bwl_ctl.c" />
    <ClCompile Include="bwl_wlan.c" />
    <ClCompile Include="bwl_data.c" />
    <ClCompile Include="netadapter.c" />
    <!-- C++: the WiFiCx front end. No sized deallocation: with it the
         array placement new in arrayofelements.hpp is ill-formed (C2956). -->
    <ClCompile Include="wificx.cpp">
      <AdditionalOptions>/Zc:sizedDealloc- %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="bcmwlsdio.h" />
    <ClInclude Include="bwl.h" />
    <ClInclude Include="bwl_regs.h" />
  </ItemGroup>

  <ItemGroup>
    <Inf Include="bcmwlsdio.inf" />
    <Inf Include="bcmwlwifi.inf" />
  </ItemGroup>


  <!--
    Stage the built .sys (and the stamped INF) into the package directory.
    Without this the package directory holds only the INF, and inf2cat's
    signability test fails with 22.9.1 "bcmwlsdio.sys ... is missing".
  -->
  <!-- The WDM lower filter the INFs install below the FDO (bwlsdflt\bwlsdflt.c). -->
  <ItemGroup>
    <ProjectReference Include="bwlsdflt\bwlsdflt.vcxproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <FilesToPackage Include="$(TargetPath)" />
    <FilesToPackage Include="$(MSBuildProjectDirectory)\bwlsdflt\$(Platform)\$(Configuration)\bwlsdflt.sys" />
    <FilesToPackage Include="@(Inf->'%(CopyOutput)')" Condition="'@(Inf)'!=''" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
