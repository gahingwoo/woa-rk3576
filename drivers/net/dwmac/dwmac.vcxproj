<?xml version="1.0" encoding="utf-8"?>
<!--
  WDK / EWDK NetAdapterCx (KMDF) driver project for dwmac (Windows on ARM64).

  Build (EWDK prompt, after LaunchBuildEnv.cmd):
      msbuild dwmac.vcxproj /p:Configuration=Release /p:Platform=ARM64
  See ..\..\..\docs\BUILDING.md (ARM64 host builds this natively).

  If MSBuild cannot resolve the WDK/NetCx targets, recreate from the VS
  "NetAdapterCx Class Extension Driver" template and add hw.c / netadapter.c +
  headers; link netadaptercx.lib.
-->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{F708B5C6-8D0E-4F2A-B13C-5D6E7F809102}</ProjectGuid>
    <TemplateGuid>{dd38f7fc-d7bd-488b-9242-7d8754cde80d}</TemplateGuid>
    <RootNamespace>dwmac</RootNamespace>
    <MinimumVisualStudioVersion>14.0</MinimumVisualStudioVersion>
    <Configuration>Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">ARM64</Platform>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
    <!--
      Catalog target list. The WDK default for ARM64 is Server10_ARM64, i.e.
      build 14393, which predates the 16299 these INFs require for DIRID 13, so
      inf2cat finds no installable DDInstall section and fails signability.
      RS3 is 16299, the real floor. 10_GE (Windows 11 24H2) is deliberately
      absent: RK3576 is ARMv8.0 and 24H2 requires ARMv8.1 LSE atomics, so it
      cannot boot on this silicon (see docs/BRINGUP-PLAN.md).
    -->
    <Inf2CatWindowsVersionList>10_RS3_ARM64,10_RS4_ARM64,10_RS5_ARM64,10_19H1_ARM64,10_VB_ARM64,10_CO_ARM64,10_NI_ARM64</Inf2CatWindowsVersionList>
    <!-- Must be declared here: the WDK targets read it at Cpp.props time. -->
    <KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
    <KMDF_VERSION_MINOR>33</KMDF_VERSION_MINOR>
    <!--
      NetAdapterDriver is what makes the WDK targets add the NetAdapterCx
      include path and import library; netadaptercx.h is not in km, it ships in
      the versioned class-extension tree keyed off NETADAPTER_VERSION_*.
    -->
    <NetAdapterDriver>true</NetAdapterDriver>
    <NETADAPTER_VERSION_MAJOR>2</NETADAPTER_VERSION_MAJOR>
    <NETADAPTER_VERSION_MINOR>1</NETADAPTER_VERSION_MINOR>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />


  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <!-- _KERNEL_MODE is predefined by the WDK toolset; redefining it is C4117. -->
      <PreprocessorDefinitions>%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <!-- NetAdapterDriver=true pulls in the NetCx import library itself. -->
      <AdditionalDependencies>$(DDK_LIB_PATH)Ksecdd.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Inf>
      <SpecifyArchitecture>true</SpecifyArchitecture>
      <Architecture>arm64</Architecture>
    </Inf>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="netadapter.c" />
    <ClCompile Include="hw.c" />
    <ClCompile Include="acpi_dsd.c" />
    <ClCompile Include="acpi_dsm.c" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="dwmac.h" />
    <ClInclude Include="dwmac_regs.h" />
  </ItemGroup>

  <ItemGroup>
    <Inf Include="dwmac.inf" />
  </ItemGroup>


  <!--
    Stage the built .sys (and the stamped INF) into the package directory.
    Without this the package directory holds only the INF, and inf2cat's
    signability test fails with 22.9.1 "dwmac.sys ... is missing".
  -->
  <ItemGroup>
    <FilesToPackage Include="$(TargetPath)" />
    <FilesToPackage Include="@(Inf->'%(CopyOutput)')" Condition="'@(Inf)'!=''" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
